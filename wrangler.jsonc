{
  // Standardmäßig aus: AI_ENABLED steht auf "false", der Worker lehnt /api/fetch und /api/step ab.
  // Lokal mit AI: npm run dev:ai (setzt AI_ENABLED=true nur für diesen Lauf).
  // Workers AI Free: Beim Überschreiten gibt es Fehler, keine Rechnung.
  "name": "market-map",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  // namespace_id ist kontoweit geteilt. Belegt: 4711 GTM OS, 4712 Lead Table + Sync Board, 4713 SDR Radar, 4714 Revenue Loop, 4715 Objection Cards, 4716 Market Map.
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "4716", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": { "AI_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct", "AI_ENABLED": "false" },
  // Aus, damit keine Seiteninhalte in Logs landen.
  "observability": { "enabled": false }
}
